APP_ENV=development
CORS_ORIGINS=http://localhost:3000
DOCUMENT_ENGINE=auto
MAX_UPLOAD_BYTES=15728640
MAX_DOCUMENT_PAGES=30
DOCUMENT_TTL_SECONDS=3600
MAX_STORED_DOCUMENTS=500
DOCLING_ARTIFACTS_PATH=/opt/docling-models
PREFETCH_DOCLING_MODELS=0
NEXT_PUBLIC_CIVIC_API_URL=http://localhost:8000
CIVIC_CORE_URL=http://civic-core:8000

# Optionale Erklärungsschicht. Der Standard bleibt vollständig deterministisch.
# Für einen in Deutschland betriebenen OpenAI-kompatiblen Endpunkt:
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REGION=DE
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=900
LLM_JSON_MODE=true
# Public WhatsApp number (E.164, e.g. +4915123456789). Shown in the web app with a QR code; leave empty to hide the section.
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_GREETING=Hallo
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0
MAX_WHATSAPP_MEDIA_BYTES=15728640
